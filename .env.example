# Copy to .env to override defaults. Never commit .env.

# Application
RAG_ENVIRONMENT=development          # development | test | production
RAG_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# Paths (relative to repo root unless absolute)
RAG_DATA_DIR=data/documents
RAG_VECTOR_DIR=storage/chroma
RAG_COLLECTION_NAME=rag_documents

# Embeddings — changing the model REQUIRES `rag reset && rag ingest`
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DEVICE=cpu             # cpu | cuda | mps

# Chunking (CHARACTERS, not tokens). overlap < size, enforced.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Retrieval
RAG_TOP_K=5
# Optional: minimum similarity (1 - cosine_distance) in [0,1]; unset = no filter
# RAG_SIMILARITY_THRESHOLD=0.25
# Bound on total characters sent to the LLM
RAG_MAX_CONTEXT_CHARS=8000

# Ollama
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.1:8b
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_TIMEOUT=120                  # seconds
